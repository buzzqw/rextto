[Unit]
Description=Rextto Rust media daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__ROOT__
ExecStart=__BIN__ --config __DATA__/rextto.json
Restart=on-failure
RestartSec=10
Environment=REXTTO_DATA_DIR=__DATA__
Environment=REXTTO_UI_DIR=__UI__
Environment=REXTTO_LISTEN=0.0.0.0:5000
Environment=REXTTO_ENGINE_LISTEN=127.0.0.1:8889
Environment=REXTTO_ACTIVE=1
Environment=REXTTO_DRY_RUN=0
Environment=REXTTO_LIBTORRENT=1
Environment=RUST_LOG=rextto=info

[Install]
WantedBy=multi-user.target
