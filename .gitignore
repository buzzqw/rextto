# Build output
/target/
/ui/target/
/ui/end2end/
**/*.profraw
**/*.profdata

# Runtime data: databases, logs, downloads, caches, state (never commit)
/data/
/import-source/
/rextto.json
/build_number
*.db
*.db-shm
*.db-wal
*.log
*.log.*
*.fastresume
*.torrent
*.part
*.magnet
ipfilter.dat

# Frontend tooling
node_modules/
dist/
.bin/

# Secrets / local environment
.env
.env.*
*.pem
*.key

# Editor / OS
.DS_Store
*.swp
*~

# Local engineering notes (may contain runtime observations and host details)
/.rextto-work-notes.md

# Extra safety: never commit key material even if renamed
*apikey*
*api_key*
*token*

# Python bytecode
__pycache__/
*.pyc
